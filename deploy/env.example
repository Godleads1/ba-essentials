# Copy to deploy/.env on the server (chmod 600) and fill in. Never commit the real file.
# Make each password with:  openssl rand -hex 32     (letters and digits only, so URLs stay valid)

# ---- The site ----
DOMAIN=bandaessentials.com
DJANGO_ALLOWED_HOSTS=bandaessentials.com,www.bandaessentials.com
CSRF_TRUSTED_ORIGINS=https://bandaessentials.com,https://www.bandaessentials.com
APP_BASE_URL=https://bandaessentials.com
# 64+ random characters:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# A Fernet key:  python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=
# Where Django admin lives (not "admin"), e.g. ops-desk
ADMIN_URL=
SECURITY_ALERT_EMAILS=
# Superusers nobody can delete, demote or switch off (emails, comma-separated): step 7 of the guide.
PROTECTED_SUPERUSER_EMAILS=
SUPPORT_EMAIL=support@bandaessentials.com
DPO_EMAIL=dpo@bandaessentials.com

# ---- Database and cache (used by docker-compose.yml) ----
POSTGRES_PASSWORD=
BANDA_OWNER_PASSWORD=
BANDA_APP_PASSWORD=
REDIS_PASSWORD=

# ---- Email (Resend) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=B & A Essentials <hello@bandaessentials.com>

# ---- Files and backups (Cloudflare R2: two private buckets) ----
PRIVATE_STORAGE_BACKEND=r2
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=banda-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_BACKEND=r2
BACKUP_R2_BUCKET=banda-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Make it with:  docker compose run --rm web python manage.py run_backups --new-key
# Keep a copy in your password manager: without it no backup can be read.
BACKUP_ENCRYPTION_KEY=

# ---- Text messages (Termii) ----
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
TERMII_WHATSAPP_FROM=
TEXT_COUNTRIES=NG

# ---- Payments (keep false until test payments have been checked) ----
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Search engines (optional) ----
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Emergency switches (docs/INCIDENT_RESPONSE.md); restart after changing ----
TEXT_MESSAGES_PAUSED=false
SIGNUPS_PAUSED=false

# ---- Only after the Privacy Policy mentions it ----
AUDIT_STORE_IP=false

# ---- Gunicorn: 2 vCPUs -> 3 workers ----
WEB_CONCURRENCY=3

# Legal entity shown in the Terms and Privacy Policy (see config/settings/base.py).
# Change only when the CAC certificate is issued.
# LEGAL_ENTITY_NAME=B&A Essential Services
# LEGAL_ENTITY_DESCRIPTION=a business name registered in Nigeria with the Corporate Affairs Commission under number BN 74100773
