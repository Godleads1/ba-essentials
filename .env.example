# Copy to .env for local development. Never commit the filled-in file.
# Production must supply these through the platform's secret manager.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# Local default is SQLite. Production must use PostgreSQL or another server DB.
DATABASE_URL=sqlite:///var/db.sqlite3

# Production: both must be true behind TLS.
SECURE_SSL_REDIRECT=false
SECURE_COOKIE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# Email (production: SMTP or a transactional provider).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=B & A Essentials <no-reply@example.com>

# Shared cache for rate limiting (production: Redis).
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=ba-essentials

# Private uploads. The noop scanner is development only.
PRIVATE_STORAGE_ROOT=var/private
PRIVATE_STORAGE_BACKEND=local
FILE_MAX_BYTES=10485760
FILE_SCAN_BACKEND=noop
# Set by the container entrypoint when CLAMD_HOST points at a TCP clamd.
CLAMD_CONFIG_FILE=
FILE_DOWNLOAD_TOKEN_TTL=300

# Payments (leave disabled until checkout and reconciliation are approved).
PAYMENTS_ENABLED=false
# Sign-in codes by SMS and WhatsApp (Termii). Leave empty to send codes by email only.
# TERMII_BASE_URL is the API address shown in your Termii dashboard (https://...).
# TERMII_WHATSAPP_FROM is your WhatsApp device name; ask Termii to switch on WhatsApp OTP first.
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
TERMII_WHATSAPP_FROM=
# Texts only go to numbers in these countries; the site-wide caps raise a security alert.
TEXT_COUNTRIES=NG
TEXT_SENDS_PER_MINUTE=30
TEXT_SENDS_PER_HOUR=300

# Emergency switches (docs/INCIDENT_RESPONSE.md). Restart after changing.
TEXT_MESSAGES_PAUSED=false
SIGNUPS_PAUSED=false
# Card-testing limits on starting a checkout.
CHECKOUT_STARTS_PER_ACCOUNT_PER_HOUR=10
CHECKOUT_STARTS_PER_IP_PER_HOUR=30

# Django admin's address (not /admin/), and the staff breached-password check.
ADMIN_URL=admin
BREACHED_PASSWORD_CHECK=true
# Keep visitors' IP addresses on audit events. Only after the Privacy Policy says so.
AUDIT_STORE_IP=false
AUDIT_IP_RETENTION_DAYS=90

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "secret hash" set in the Flutterwave dashboard under Webhooks.
FLUTTERWAVE_WEBHOOK_HASH=

# Authentication policy. Changing these is a product decision.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
SESSION_IDLE_TIMEOUT=3600
SESSION_COOKIE_AGE=28800
STEP_UP_MAX_AGE=600
QUOTE_VALIDITY_DAYS=14
MFA_ISSUER=B & A Essentials
MFA_ENC_CONTEXT=ba-essentials-mfa-v1  # public derivation context, not a secret; gitleaks:allow

# Visitor address for rate limits (apps/core/client_ip.py). Set ONE, to match the proxies
# in front of the app; never trust the left-hand X-Forwarded-For entries.
# TRUSTED_PROXY_COUNT=1                    # e.g. one nginx or load balancer
# CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP   # Cloudflare in front, origin reachable only through it
TRUSTED_PROXY_COUNT=0
CLIENT_IP_HEADER=

# Who hears about security alerts (lockouts, staff access changes, refused downloads), comma-separated.
SECURITY_ALERT_EMAILS=

# Private files: "local" for development; "r2" for Cloudflare R2 in production.
# The bucket must stay private; the API token should be limited to this one bucket.
# PRIVATE_STORAGE_BACKEND=r2
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Backups (docs/BACKUPS.md). Make the key with: python manage.py run_backups --new-key
BACKUP_BACKEND=local
BACKUP_ENCRYPTION_KEY=
# BACKUP_BACKEND=r2
# BACKUP_R2_BUCKET=banda-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_KEEP_HOURS=48
RESTORE_CHECK_DATABASE_URL=

# Authenticator secrets get their own key, so DJANGO_SECRET_KEY can be rotated safely.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Total storage for a business's own uploads, in bytes (default 2 GB; 0 = no limit).
ORG_STORAGE_LIMIT_BYTES=2147483648
