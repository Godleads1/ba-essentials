# Copy to .env for local development. Never commit the filled-in file.
# Production must supply these through the platform's secret manager.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# Local default is SQLite. Production must use PostgreSQL or another server DB.
DATABASE_URL=sqlite:///var/db.sqlite3

# Production: both must be true behind TLS.
SECURE_SSL_REDIRECT=false
SECURE_COOKIE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# Email (production: SMTP or a transactional provider).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=B & A Essentials <no-reply@example.com>

# Shared cache for rate limiting (production: Redis).
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=ba-essentials

# Private uploads. The noop scanner is development only.
PRIVATE_STORAGE_ROOT=var/private
PRIVATE_STORAGE_BACKEND=local
FILE_MAX_BYTES=10485760
FILE_SCAN_BACKEND=noop
FILE_DOWNLOAD_TOKEN_TTL=300

# Payments (leave disabled until checkout and reconciliation are approved).
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Authentication policy. Changing these is a product decision.
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
SESSION_IDLE_TIMEOUT=3600
SESSION_COOKIE_AGE=28800
STEP_UP_MAX_AGE=600
QUOTE_VALIDITY_DAYS=14
MFA_ISSUER=B & A Essentials
MFA_ENC_KEY_SALT=ba-essentials-mfa-v1
